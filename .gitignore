# ============================================================
# GuardAI - Git Ignore Configuration
# ============================================================

# 1. Environment variables and API credentials (CRITICAL: Never commit!)
.env
.env.*
!.env.example
*.env
backend/.env

# 2. Third-party dependencies
node_modules/
backend/node_modules/

# 3. Logs and runtime dumps
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 4. Operating System temporary files
.DS_Store
Thumbs.db
desktop.ini

# 5. Office / Word temporary lock files (e.g. while editing reports)
~$*

# 6. IDE and Editor directories
.vscode/
.idea/