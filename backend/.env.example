# ============================================================
# GuardAI Backend - Environment Configuration Template
# ============================================================
# Instructions: Copy this file to '.env' and add your real credentials.
# NEVER commit your real '.env' file to GitHub!

# Server Port
PORT=3001

# Allowed Origins for CORS (use * for local development)
CORS_ORIGIN=*

# Google Gemini API Key
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
LLM_API_KEY=your_gemini_api_key_here